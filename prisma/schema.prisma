// Industrial Engineering Hub V0.2 — Prisma schema
// Data source: Neon Serverless Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Keyword & AI task plumbing (Sprint 2) ───────────────────────────────────

model Keyword {
  id         String   @id @default(cuid())
  phrase     String   @unique
  intent     String?  // informational|transactional|navigational|commercial
  priority   String?  // P0|P1|P2
  volume     Int?
  difficulty Int?
  brief      Json?    // {headline, targetAudience, painPoints[], suggestedFormulas[], outline[]}
  status     String   @default("new") // new|analyzed|assigned|published
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  AiTask     AiTask[]
  ContentItem ContentItem[]
  Calculator Calculator[]
}

model AiTask {
  id         String   @id @default(cuid())
  agent      String   // keyword|writer|reviewer|calc-writer
  status     String   @default("pending") // pending|running|done|failed
  input      Json
  output     Json?
  error      String?
  model      String?
  tokensIn   Int?
  tokensOut  Int?
  costUsd    Float?
  keywordId  String?
  Keyword    Keyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  contentId  String?
  ContentItem ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  finishedAt DateTime?
}

// ─── Calculators (Sprint 3) ──────────────────────────────────────────────────

model Calculator {
  id          String    @id            // e.g. "pipe-flow-calculator"
  name        String
  category    String
  priority    String    // P0|P1|P2
  description String
  schema      Json      // full Calculator object matching src/lib/calculator/types.ts
  status      String    @default("draft") // draft|review|approved|published|archived
  testsPass   Int       @default(0)
  testsFail   Int       @default(0)
  keywordId   String?
  Keyword     Keyword?  @relation(fields: [keywordId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

// ─── Content (guides + materials) & Reviews (Sprint 4) ───────────────────────

model ContentItem {
  id           String    @id @default(cuid())
  slug         String
  kind         String    // guide|material
  title        String
  description  String
  category     String?
  keywords     String[]  @default([])
  bodyMdx      String    // MDX body (frontmatter stored separately)
  frontmatter  Json?     // author, updated, related[], etc.
  status       String    @default("keyword")
  // status machine: keyword → brief_generated → ai_draft → engineering_review → seo_review → published → archived
  keywordId    String?
  Keyword      Keyword?  @relation(fields: [keywordId], references: [id])
  seoScore     Int?
  Review       Review[]
  AiTask       AiTask[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?

  @@unique([kind, slug])
}

model Review {
  id            String      @id @default(cuid())
  contentId     String
  ContentItem   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reviewer      String      // ai-engineering|ai-seo|human
  scoreAccuracy Int?        // 40% weight
  scoreLogic    Int?        // 30%
  scoreSeo      Int?        // 20%
  scoreOrig     Int?        // 10%
  overall       Int?
  verdict       String?     // publish|revise|rewrite
  comments      Json?
  createdAt     DateTime    @default(now())
}

// ─── Leads (CRM) ──────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  industry    String
  projectType String
  location    String?
  projectSize String?
  services    String[] @default([])
  timeline    String?
  message     String   @db.Text
  source      String   @default("contact-form") // contact-form|calculator-cta|service-cta|industry-cta
  sourceRef   String?  // e.g. tool slug, /services/<slug>
  status      String   @default("new") // new|contacted|qualified|won|lost|spam
  notes       String?  @db.Text
  ipCountry   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contactedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// ─── SEO Growth Engine (V0.4) ────────────────────────────────────────────────

model SeoMetric {
  id           String   @id @default(cuid())
  date         DateTime
  query        String
  page         String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  ctr          Float    @default(0)
  position     Float    @default(0)
  country      String?  // e.g. "usa", "chn", "global"
  device       String?  // "desktop"|"mobile"|"tablet"
  createdAt    DateTime @default(now())

  @@unique([date, query, page])
  @@index([date])
  @@index([query])
  @@index([page])
  @@index([position])
}

model PageSeoMeta {
  id           String   @id @default(cuid())
  url          String   @unique
  title        String?
  h1           String?
  wordCount    Int      @default(0)
  hasFaq       Boolean  @default(false)
  hasSchema    Boolean  @default(false)
  internalLinks Int     @default(0)
  cluster      String?  // topic cluster name e.g. "steel-engineering"
  lastAudited  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeoAiDecision {
  id            String   @id @default(cuid())
  type          String   // "opportunity"|"optimization"|"cluster"|"keyword-research"
  inputData     Json     // GSC data / page data that was analyzed
  analysis      Json?    // LLM analysis output
  recommendation String?
  actions       Json?    // [{ action, target, priority }]
  confidence    Float?
  model         String?  // e.g. "claude-sonnet"
  status        String   @default("pending") // pending|approved|rejected|executed
  createdAt     DateTime @default(now())
}

// ─── Share Results (Calculator Viral Loop) ────────────────────────────────────

model ShareResult {
  id           String   @id @default(cuid())
  calculator   String   // calculator slug
  calculatorName String // display name
  inputData    Json     // { length: 2000, width: 1000, ... }
  resultData   Json     // { value: 157, unit: "kg", label: "Weight" }
  formula      String?  // formula expression
  views        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([calculator])
  @@index([createdAt])
}

// ─── V0.3 SEO Growth Operating System ───────────────────────────────────────

model SeoDecision {
  id            String   @id @default(cuid())
  pageUrl       String?  // target page (nullable for site-wide decisions)
  query         String?  // target query
  decisionType  String   // content_expansion|title_optimization|internal_links|new_content|cluster_building|technical_seo
  problem       String?  // description of the problem
  analysis      Json?    // { query, position, intent, competitors }
  actions       Json?    // [{ action, payload, priority }]
  confidence    Float    @default(0)
  priority      Int      @default(50) // 0-100 Opportunity Score
  status        String   @default("pending") // pending|approved|rejected|executing|executed
  approvedBy    String?
  approvedAt    DateTime?
  executedAt    DateTime?
  result        Json?    // post-execution metrics
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  SeoActions    SeoAction[]

  @@index([status])
  @@index([priority])
  @@index([pageUrl])
}

model SeoAction {
  id            String   @id @default(cuid())
  decisionId    String
  SeoDecision   SeoDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  action        String   // expand_section|rewrite_intro|add_examples|add_table|add_faq|update_title|update_meta|update_schema|improve_internal_links|create_hub|create_pillar|create_support_article
  payload       Json?    // action-specific data
  status        String   @default("pending") // pending|approved|executing|done|failed
  result        String?
  createdAt     DateTime @default(now())
  executedAt    DateTime?

  @@index([decisionId])
  @@index([status])
}

model TopicCluster {
  id            String   @id @default(cuid())
  name          String   @unique
  parentTopic   String?  // parent cluster name for hierarchy
  pillarPage    String?  // URL of the pillar page
  authorityScore Int     @default(0) // 0-100
  pageCount     Int      @default(0)
  totalImpressions Int   @default(0)
  totalClicks   Int      @default(0)
  avgPosition   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([parentTopic])
}

model PageScore {
  id            String   @id @default(cuid())
  pageUrl       String   @unique
  pageType      String   // calculator|guide|material|service|cluster|other
  contentScore  Int      @default(0)  // 0-100
  keywordScore  Int      @default(0)
  linksScore    Int      @default(0)
  searchScore   Int      @default(0)  // based on GSC performance
  eeattScore    Int      @default(0)  // E-E-A-T
  totalScore    Int      @default(0)  // weighted total 0-100
  rankingStage  String   @default("discovery") // winner|striking_distance|growth|discovery
  impressions   Int      @default(0)
  clicks       Int      @default(0)
  avgPosition   Float    @default(0)
  contentMaturity Int      @default(0)
  clusterName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rankingStage])
  @@index([totalScore])
  @@index([clusterName])
}

model KeywordIntent {
  id            String   @id @default(cuid())
  query         String   @unique
  intent        String   // informational|calculator|commercial|reference|comparison
  searchVolume  Int?
  difficulty    Int?
  currentPosition Float?
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  targetPage    String?
  priority      Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([intent])
  @@index([priority])
}

