  "content": {
    "introduction": "Convert between common volumetric flow rate units used in engineering: cubic meters per hour/second, liters per minute/second, and US gallons per minute.",
    "example": {
      "inputs": {
        "input_flow": 100,
        "from_factor": "3600",
        "to_factor": "15850"
      },
      "result": 440.3,
      "description": "100 m³/h = 440.3 GPM (US gallons per minute)."
    },
    "faq": [
      {
        "q": "What is the conversion from m³/h to GPM?",
        "a": "1 m³/h = 4.403 US GPM. 1 m³/h = 3.666 UK (imperial) GPM."
      },
      {
        "q": "How do I convert mass flow to volumetric flow?",
        "a": "Volumetric flow (m³/s) = mass flow (kg/s) / density (kg/m³). For water, 1 kg/s ≈ 3.6 m³/h."
      }
