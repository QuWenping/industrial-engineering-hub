  "content": {
    "introduction": "Convert between common engineering pressure units. Standard pressure unit conversions for hydraulic, pneumatic, process, and mechanical engineering.",
    "example": {
      "inputs": {
        "input": 100,
        "fromFactor": "1000",
        "toFactor": "6894.76"
      },
      "result": 14.5,
      "description": "100 kPa = 14.5 psi (approximately 1 atmosphere)."
    },
    "faq": [
      {
        "q": "What is the exact conversion from bar to psi?",
        "a": "1 bar = 14.5038 psi = 100 kPa = 0.9869 atm. 1 bar is slightly less than 1 atmosphere (1 atm = 1.01325 bar)."
      },
      {
        "q": "What is the difference between gauge and absolute pressure?",
        "a": "P_abs = P_gauge + P_atm. 100 kPa gauge = ~201.3 kPa absolute. This converter works with both, just be consistent."
      },
      {
        "q": "How do I convert between kPa and bar?",
        "a": "1 bar = 100 kPa. For example, 5 bar = 500 kPa. Conversely, divide kPa by 100 to get bar."
      }
