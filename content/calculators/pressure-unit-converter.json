  "formula": {
    "expression": "input * fromFactor / toFactor",
    "unit": "",
    "explanation": "Converts pressure via Pascal reference: result = input × (Pa_per_fromUnit / Pa_per_toUnit). Factors are Pa per unit: Pa=1, kPa=1000, bar=100000, psi=6895, atm=101325."
  },
